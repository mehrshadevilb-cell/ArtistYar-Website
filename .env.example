RAHYAR_API_URL=https://rahyar-academy-management-system-v14.onrender.com

# UVR-based AI stem separation worker (separate GPU service)
UVR_WORKER_URL=https://YOUR-GPU-WORKER.example.com
UVR_WORKER_SECRET=generate-a-long-random-worker-secret

RAHYAR_AI_GATEWAY_URL=
RAHYAR_AI_BRIDGE_SECRET=

ARTISTYAR_ADMIN_USERNAME=mehrshad
ARTISTYAR_ADMIN_PASSWORD=change-me-to-a-strong-password
ARTISTYAR_SESSION_SECRET=generate-a-long-random-secret
WEB_ADMIN_API_KEY=generate-a-separate-admin-api-key

# Multi-Agent Development — server-side GitHub write access
# Use a fine-grained token with access only to this repository and Contents + Pull requests.
GITHUB_TOKEN=
GITHUB_REPOSITORY=mehrshadevilb-cell/ArtistYar-Website

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=artistyar-media

# Practice Pro — card-to-card phase
NEXT_PUBLIC_PRO_CARD_NUMBER=
NEXT_PUBLIC_PRO_CARD_HOLDER=

# Telegram -> Plugin Library (files remain on Telegram; no plugin ZIP/RAR is stored in site Storage)\nTELEGRAM_BOT_TOKEN=\nTELEGRAM_PLUGIN_CHANNEL_ID=@ProAudios\nTELEGRAM_PLUGIN_WEBHOOK_SECRET=\nPLUGIN_AI_VISION_MODEL=gpt-4o-mini\nPLUGIN_AI_GEMINI_MODEL=gemini-2.5-flash\n\n# Daily Telegram practice encouragement (shared secret with RahYar bot)
ARTISTYAR_PRACTICE_REMINDER_SECRET=

