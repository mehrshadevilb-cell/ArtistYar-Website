# Production: https://artistyaar.ir
# Local:      http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://artistyaar.ir

# ---------------------------------------------------------------------------
# AI providers (server-side only)
# Site discovers ALL models from every key you set and auto-failover:
# if one model/provider fails → next working model immediately.
# ---------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude (Anthropic) — also accepts CLAUDE_API_KEY / CLAUD_API_KEY
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Fast / multi-model gateways
GROQ_API_KEY=
OPENROUTER_API_KEY=

# More OpenAI-compatible providers
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
# GROK_API_KEY=

# Cloudflare / Flare (OpenAI-compatible base)
# FLARE_API_KEY=
# FLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Custom slots (any OpenAI-compatible API)
# ORCA_API_KEY=
# ORCA_BASE_URL=
# ORCA_MODEL=
# KIRA_API_KEY=
# KIRA_BASE_URL=
# KIRA_MODEL=
# CUSTOM_AI_1_API_KEY=
# CUSTOM_AI_1_BASE_URL=
# CUSTOM_AI_1_NAME=MyProvider
# CUSTOM_AI_1_MODEL=my-model-id

# Optional RahYar backend gateway
RAHYAR_API_URL=https://rahyar-academy-management-system-v14.onrender.com
RAHYAR_AI_GATEWAY_URL=
RAHYAR_AI_BRIDGE_SECRET=

RAHYAR_WEB_API_SECRET=

ARTISTYAR_ADMIN_USERNAME=mehrshad
ARTISTYAR_ADMIN_PASSWORD=change-me-to-a-strong-password
ARTISTYAR_SESSION_SECRET=generate-a-long-random-secret
WEB_ADMIN_API_KEY=generate-a-separate-admin-api-key

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=artistyar-media
