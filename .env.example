# Production: https://artistyaar.ir
# Local:      http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://artistyaar.ir

# ---------------------------------------------------------------------------
# AI providers (server-side only) — put keys on the WEBSITE env
# Site auto-discovers models and picks the best available.
# At least one of these should be set for /assistant to work.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional custom OpenAI-compatible base (Azure, LiteLLM, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Google Gemini (any of these names works)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional: RahYar backend gateway (fallback if direct keys fail / not set)
RAHYAR_API_URL=https://rahyar-academy-management-system-v14.onrender.com
RAHYAR_AI_GATEWAY_URL=
RAHYAR_AI_BRIDGE_SECRET=

# Optional legacy web API secret for non-AI backend routes
RAHYAR_WEB_API_SECRET=

# Admin login for website panel (REQUIRED in production — no demo accounts)
ARTISTYAR_ADMIN_USERNAME=mehrshad
ARTISTYAR_ADMIN_PASSWORD=change-me-to-a-strong-password
# Separate random secret used to sign/revoke website admin sessions.
ARTISTYAR_SESSION_SECRET=generate-a-long-random-secret
# Must match the backend WEB_ADMIN_API_KEY for live lesson/student admin APIs.
WEB_ADMIN_API_KEY=generate-a-separate-admin-api-key

# Supabase Storage (secret key is server-side only; never expose it to the browser)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=artistyar-media
