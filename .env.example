# Production: https://artistyaar.ir
# Local:      http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://artistyaar.ir

# ---------------------------------------------------------------------------
# AI — site discovers models from every key and failovers fast
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=

# Gateways / OpenAI-compatible routers
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Optional: leave blank to use the live /v1/models catalog.
XKIRO_MODEL=
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODEL=gpt-5.5

# Bytez — unified API for 100,000+ models
# https://api.bytez.com/models/v2/openai/v1
BYTEZ_API_KEY=
