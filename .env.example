NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RahYar backend (optional fallback / legacy integration, no trailing slash)
RAHYAR_API_URL=http://127.0.0.1:8000

# Optional — must match WEB_API_SECRET on the bot if set
RAHYAR_WEB_API_SECRET=

# AI providers (server-side only; never use NEXT_PUBLIC_ for these keys)
BYTEZ_API_KEY=
DAHL_API_KEY=

# Provider priority for automatic discovery + failover
# Example: bytez,dahl
AI_PROVIDER_ORDER=bytez,dahl
